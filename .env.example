# Copy this file to .env and fill in your values.
# The .env file is git-ignored so secrets are never committed.

# ── OpenAI (required for natural-language search) ──────────────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── SMTP email (optional – approval emails are skipped when blank) ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Facebook OAuth (optional) ───────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
